<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_overlay">

    <!-- Top-Right Close Button (X) -->
    <TextView
        android:id="@+id/btnCloseOverlay"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/close_overlay_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="✕"
        android:textColor="@color/text_overlay_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Warning Icon / Badge -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_overlay_bg"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="STRICT SCREEN LOCK"
            android:textColor="@color/primary_red"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="YouTube Shorts Locked"
            android:textColor="@color/text_overlay_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLockMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="You have reached your Shorts scrolling limit. YouTube is locked for 30 minutes."
            android:textColor="@color/text_overlay_secondary"
            android:textSize="14sp" />

        <!-- Big Countdown Timer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/card_overlay_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="20dp"
            android:paddingEnd="40dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/tvCountdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="TIME REMAINING"
                android:textColor="@color/text_overlay_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="29:59"
                android:textColor="@color/primary_red"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Go to Home Screen Button -->
        <Button
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/accent_cyan"
            android:text="Go to Home Screen"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Emergency PIN Section -->
        <LinearLayout
            android:id="@+id/pinSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEmergencyPinToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="Unlock with Security PIN"
                android:textColor="#0284C7"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/pinInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etPin"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/pin_input_bg"
                    android:gravity="center"
                    android:hint="Enter 4-digit PIN"
                    android:inputType="numberPassword"
                    android:maxLength="4"
                    android:padding="10dp"
                    android:textColor="@color/text_overlay_primary"
                    android:textColorHint="@color/text_overlay_secondary" />

                <Button
                    android:id="@+id/btnUnlockPin"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/accent_emerald"
                    android:text="Unlock"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
